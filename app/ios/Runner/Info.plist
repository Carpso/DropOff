	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Share your live pickup location with the sender and route riders efficiently.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo for your profile, rider verification and parcel evidence.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick photos for your profile, rider verification and parcel evidence.</string>
