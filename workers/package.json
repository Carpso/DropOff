{
  "name": "dropoff-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute dropoff-db --remote --file=./migrations/0001_schema.sql",
    "db:local": "wrangler d1 execute dropoff-db --local --file=./migrations/0001_schema.sql"
  },
  "dependencies": {
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
